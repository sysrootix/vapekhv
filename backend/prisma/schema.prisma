// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  telegramId        BigInt   @unique
  username          String?
  firstName         String?
  lastName          String?
  phone             String?
  photoUrl          String?
  languageCode      String?
  isPremium         Boolean  @default(false)
  isBot             Boolean  @default(false)

  // Бонусная программа
  bonusPoints       Int      @default(0)
  totalSpent        Float    @default(0)
  firstOrderDiscount Boolean @default(true) // 10% на первый заказ

  // Реферальная программа
  referralCode      String?  @unique // Уникальный реферальный код пользователя
  referredById      String?  // ID пользователя, который пригласил
  referredBy        User?    @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]   @relation("UserReferrals")
  referralInvites   Referral[] @relation("ReferralInviter")
  referralReward    Referral?  @relation("ReferralInvitee")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastLoginAt       DateTime @default(now())

  cartItems         CartItem[]
  orders            Order[]
  bonusTransactions BonusTransaction[]
  productViews      ProductView[]
  savedAddresses    SavedAddress[]
  userAchievements  UserAchievement[]
  stockNotifications StockNotification[]
  reviews           Review[]
  audiencesCreated  Audience[] @relation("AudienceCreatedBy")

  @@map("users")
  @@index([telegramId])
  @@index([referralCode])
  @@index([referredById])
}

model BonusTransaction {
  id          String              @id @default(cuid())
  amount      Int                 // Количество бонусов (может быть отрицательным при списании)
  type        BonusTransactionType
  description String?
  
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  orderId     String?
  referralId  String?
  referral    Referral?           @relation(fields: [referralId], references: [id], onDelete: SetNull)
  promoCodeId String?
  promoCode   PromoCode?          @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime            @default(now())

  @@map("bonus_transactions")
  @@index([userId])
  @@index([referralId])
  @@index([promoCodeId])
  @@index([createdAt])
}

enum BonusTransactionType {
  EARNED      // Начислено за покупку
  SPENT       // Списано при оплате
  GIFT        // Подарок от администратора
  EXPIRED     // Истекли
  REFUND      // Возврат при отмене заказа
  REFERRAL    // Начисление за реферала
  PROMO       // Бонус по промокоду
}

model Referral {
  id            String          @id @default(cuid())
  inviterId     String
  inviteeId     String
  status        ReferralStatus  @default(PENDING)
  bonusAmount   Int             @default(100)
  notifiedAt    DateTime?
  qualifiedAt   DateTime?
  rewardedAt    DateTime?
  firstOrderId  String?

  inviter       User            @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee       User            @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  bonusTransactions BonusTransaction[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("referrals")
  @@unique([inviteeId])
  @@index([inviterId])
}

enum ReferralStatus {
  PENDING    // Приглашенный пользователь еще не сделал заказ
  QUALIFIED  // Пользователь сделал заказ, ожидается начисление
  REWARDED   // Бонус начислен
  CANCELLED  // Бонус не будет начислен
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)

  // Иерархия категорий
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")

  // МойСклад интеграция
  moySkladId  String?   @unique // ID из МойСклад
  moySkladUpdated DateTime? // Время последнего обновления из МойСклад

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
  @@index([moySkladId])
  @@index([parentId])
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  price       Float
  oldPrice    Float?
  imageUrl    String?
  images      String[]  @default([])
  inStock     Boolean   @default(true)
  stockCount  Int       @default(0)
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)

  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // МойСклад интеграция
  moySkladId  String?   @unique // ID из МойСклад
  moySkladUpdated DateTime? // Время последнего обновления из МойСклад
  article     String?   // Артикул товара
  code        String?   // Код товара
  externalCode String?  // Внешний код

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cartItems       CartItem[]
  orderItems      OrderItem[]
  variants        ProductVariant[]
  characteristics ProductCharacteristic[]
  productViews    ProductView[]
  stockNotifications StockNotification[]
  reviews         Review[]

  @@map("products")
  @@index([categoryId])
  @@index([slug])
  @@index([moySkladId])
}

model ProductCharacteristic {
  id          String   @id @default(cuid())
  name        String   // например "Вкус", "Цвет", "Размер"
  values      String[] // например ["Шоколад", "Ваниль", "Клубника"]
  required    Boolean  @default(true)
  sortOrder   Int      @default(0)
  
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("product_characteristics")
  @@unique([productId, name])
  @@index([productId])
}

model ProductVariant {
  id                String   @id @default(cuid())
  sku               String?  @unique
  price             Float?   // Если null, используется цена продукта
  oldPrice          Float?
  stockCount        Int      @default(0)
  inStock           Boolean  @default(true)
  characteristics   Json     // {"Вкус": "Шоколад", "Размер": "M"}

  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // МойСклад интеграция
  moySkladId        String?  @unique // ID модификации из МойСклад
  moySkladUpdated   DateTime? // Время последнего обновления из МойСклад

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("product_variants")
  @@index([productId])
  @@index([moySkladId])
}

model CartItem {
  id              String   @id @default(cuid())
  quantity        Int      @default(1)
  selectedOptions Json?    // {"Вкус": "Шоколад", "Размер": "M"}
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cart_items")
  @@index([userId])
  @@index([productId])
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  status           OrderStatus @default(PENDING_PAYMENT)
  totalAmount      Float
  deliveryCost     Float       @default(0) // Стоимость доставки
  adminDeliveryCost Float?     // Стоимость доставки, установленная админом
  bonusUsed        Int         @default(0) // Сколько бонусов использовано
  bonusEarned      Int         @default(0) // Сколько бонусов начислено
  promoCodeId      String?
  promoCodeType    PromoCodeType?
  promoDiscount    Float       @default(0)
  promoBonus       Int         @default(0)
  promoFreeDelivery Boolean    @default(false)

  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  promoCode        PromoCode?  @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  deliveryAddress  String?
  deliveryPhone    String?
  deliveryDate     String?     // Дата доставки
  deliveryTime     String?     // Время доставки
  comment          String?

  // Платежная информация
  receiptImageUrl  String?   @map("receipt_image_url")
  paymentExpiresAt DateTime? @map("payment_expires_at")
  paidAt           DateTime? @map("paid_at")

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items            OrderItem[]
  reviews          Review[]

  @@map("orders")
  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentExpiresAt])
  @@index([promoCodeId])
}

model OrderItem {
  id              String   @id @default(cuid())
  quantity        Int
  price           Float
  selectedOptions Json?    // {"Вкус": "Шоколад", "Размер": "M"}
  
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  createdAt       DateTime @default(now())

  @@map("order_items")
  @@index([orderId])
}

enum OrderStatus {
  PENDING_PAYMENT    // Ожидает оплаты (1 час)
  PENDING            // Ожидает подтверждения от администратора
  CONFIRMED          // Подтвержден администратором
  PROCESSING         // В процессе сборки
  SHIPPED            // Отправлен/в пути
  DELIVERED          // Доставлен
  CANCELLED          // Отменен
  PAYMENT_EXPIRED    // Время оплаты истекло
}

// История изменений заказов
model OrderHistory {
  id          String   @id @default(cuid())
  orderId     String
  changedBy   String   // ID администратора или 'SYSTEM'
  changedByName String? // Имя администратора
  field       String   // 'status', 'deliveryCost', etc.
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  @@map("order_history")
  @@index([orderId])
  @@index([createdAt])
}

// Промокоды
model PromoCode {
  id              String          @id @default(cuid())
  code            String          @unique
  type            PromoCodeType
  value           Float           // Процент скидки или фиксированная сумма
  minOrderAmount  Float           @default(0)
  validFrom       DateTime        @default(now())
  validUntil      DateTime?
  usageLimit      Int?            // Лимит использований (null = безлимит)
  usedCount       Int             @default(0)
  isActive        Boolean         @default(true)
  description     String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  orders          Order[]
  bonusTransactions BonusTransaction[]

  @@map("promo_codes")
  @@index([code])
  @@index([validUntil])
}

enum PromoCodeType {
  PERCENT         // Процентная скидка
  FIXED           // Фиксированная скидка
  FREE_DELIVERY   // Бесплатная доставка
  BONUS           // Дополнительные бонусы

  @@map("promo_code_type")
}

// Достижения
model Achievement {
  id              String   @id @default(cuid())
  title           String
  description     String
  icon            String   // emoji или URL иконки
  requirement     String   // Текстовое описание требования
  requirementType AchievementType
  requirementValue Float   // Значение для проверки (например, 10 заказов)
  reward          Int      // Бонусы за достижение
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userAchievements UserAchievement[]

  @@map("achievements")
  @@index([requirementType])
}

enum AchievementType {
  FIRST_ORDER       // Первый заказ
  ORDERS_COUNT      // Количество заказов
  TOTAL_SPENT       // Общая сумма покупок
  ORDERS_IN_ROW     // Заказов подряд в месяц
  REFERRALS_COUNT   // Количество приглашенных
}

// Связь пользователя и достижений
model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  progress      Float       @default(0) // Текущий прогресс
  isCompleted   Boolean     @default(false)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("user_achievements")
  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([isCompleted])
}

// История просмотров товаров
model ProductView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@map("product_views")
  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@index([productId])
}

// Сохраненные адреса доставки
model SavedAddress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   // "Дом", "Работа", "Другой"
  address     String
  phone       String?
  comment     String?
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("saved_addresses")
  @@index([userId])
}

// Уведомления о наличии товара
model StockNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  notifiedAt DateTime?

  @@map("stock_notifications")
  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([notified])
}

// Отзывы на товары
model Review {
  id          String   @id @default(cuid())
  rating      Int      // Оценка от 1 до 5
  text        String?  // Текст отзыва
  images      String[] @default([]) // Массив URL изображений
  videos      String[] @default([]) // Массив URL видео
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  bonusAwarded Int     @default(0) // Бонусы, начисленные за отзыв
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reviews")
  @@unique([userId, productId]) // Один отзыв на товар от пользователя
  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([rating])
  @@index([createdAt])
}

model Audience {
  id              String   @id @default(cuid())
  name            String
  description     String?
  filters         Json
  userCount       Int      @default(0)
  lastEvaluatedAt DateTime?

  createdById     String?
  createdBy       User?    @relation("AudienceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("crm_audiences")
  @@index([createdById])
  @@index([createdAt])
}
